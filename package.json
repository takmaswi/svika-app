{
  "name": "svika",
  "private": true,
  "version": "0.1.0",
  "description": "Digital ticketing and trip intelligence for Harare's informal kombi network.",
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter web test:e2e",
    "build": "pnpm -r --if-present build",
    "db:security-test": "pnpm --filter @svika/db security-test",
    "db:seed": "pnpm --filter @svika/db seed",
    "db:service-days": "pnpm --filter @svika/db service-days",
    "db:demo-reset": "pnpm --filter @svika/db demo-reset",
    "auth:verify": "pnpm --filter web auth:verify",
    "db:ledger-test": "pnpm --filter @svika/db ledger-test",
    "db:places-test": "pnpm --filter @svika/db places-test",
    "db:offline-test": "pnpm --filter @svika/db offline-test",
    "db:beacon-test": "pnpm --filter @svika/db beacon-test",
    "spine:ingest": "pnpm --filter @svika/spine ingest",
    "spine:train": "pnpm --filter @svika/spine train",
    "watchdog:eval": "pnpm --filter @svika/spine watchdog:eval",
    "watchdog:run": "pnpm --filter @svika/spine watchdog:run",
    "watchdog:bad-day": "pnpm --filter @svika/spine watchdog:bad-day",
    "map:tiles": "node tools/map-tiles/build-tiles.mjs",
    "geocode:index": "node tools/geocode-index/build-index.mjs",
    "map:fonts": "node tools/map-tiles/build-glyphs.mjs",
    "map:glyphs:gz": "node tools/map-tiles/compress-glyphs.mjs",
    "map:sprites": "node tools/map-tiles/build-sprites.mjs",
    "map:assets": "node tools/map-tiles/build-sprites.mjs && node tools/map-tiles/build-glyphs.mjs && node tools/map-tiles/compress-glyphs.mjs && node tools/map-tiles/build-tiles.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@eslint/js": "9.18.0",
    "@mapbox/vector-tile": "2.0.5",
    "eslint": "9.18.0",
    "globals": "15.14.0",
    "next": "15.1.12",
    "pbf": "4.0.2",
    "pmtiles": "4.4.1",
    "prettier": "3.4.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.20.0"
  }
}
